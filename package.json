{
  "name": "akr-monorepo",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start:api": "pnpm --filter @akr/api start",
    "db:setup": "turbo run db:setup --filter=@akr/api",
    "db:start": "docker compose up -d",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "install:all": "pnpm install && turbo run db:setup --filter=@akr/api"
  },
  "devDependencies": {
    "turbo": "^2.8.20"
  }
}