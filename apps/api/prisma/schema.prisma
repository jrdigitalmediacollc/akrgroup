// =============================================================================
// AKR Group Database Schema
// PostgreSQL + Prisma
// NestJS + JWT Auth + Redis
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS (UPPERCASE as per specification)
// =============================================================================

enum UserRole {
  ADMIN
  ADVISOR
  CUSTOMER
  LISTER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
}

enum CalculatorType {
  MORTGAGE
  ROI
  MUTUAL_FUND
}

enum InvestmentMode {
  LUMP_SUM
  SIP
}

enum ListingType {
  BUY
  RENT
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum EmailStatus {
  SENT
  FAILED
  PENDING
}

enum DisclaimerPage {
  MORTGAGE_CALCULATOR
  ROI_CALCULATOR
  MUTUAL_FUND_CALCULATOR
  PROPERTIES
  CONTACT
  FOOTER
}

// =============================================================================
// MODELS
// =============================================================================

// -----------------------------------------------------------------------------
// User
// id (cuid), email (unique), passwordHash, role (enum), name, phone, isActive, timestamps
// -----------------------------------------------------------------------------
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(CUSTOMER)
  name         String
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  leadsAsAdvisor    Lead[]              @relation("LeadsByAdvisor")
  calculatorResults CalculatorResult[]
  listings          Listing[]
  paymentRequests   PaymentRequest[]
  auditLogs         AuditLog[]

  @@map("users")
  @@index([role])
  @@index([isActive])
}

// -----------------------------------------------------------------------------
// Lead
// CRM-less mode: capture from calculators, segment by advisor, export CSV
// -----------------------------------------------------------------------------
model Lead {
  id        String        @id @default(cuid())
  name      String
  email     String      @unique
  phone     String?
  source    CalculatorType @map("source")
  advisorId String?        @map("advisor_id")
  status    LeadStatus     @default(NEW)
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  // Relations
  advisor           User?             @relation("LeadsByAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  calculatorResults CalculatorResult[]
  paymentRequests   PaymentRequest[]
  emailLogs         EmailLog[]

  @@map("leads")
  @@index([advisorId, status])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// CalculatorResult
// Stores mortgage loan, ROI/XIRR (lump sum + SIP), mutual fund calculations
// -----------------------------------------------------------------------------
model CalculatorResult {
  id             String          @id @default(cuid())
  userId         String?         @map("user_id")
  leadId         String?         @map("lead_id")
  type           CalculatorType
  investmentMode InvestmentMode?
  inputs         Json
  outputs        Json
  referenceId    String          @unique @map("reference_id")
  pdfUrl         String?         @map("pdf_url")
  createdAt      DateTime        @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@map("calculator_results")
  @@index([userId, leadId, type])
  @@index([type])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Listing
// Submitted by listers, admin approval required, no direct investor contact
// -----------------------------------------------------------------------------
model Listing {
  id           String        @id @default(cuid())
  listerId     String        @map("lister_id")
  title        String
  description  String
  type         ListingType
  price        Decimal       @db.Decimal(15, 2)
  currency     String        @default("AED")
  location     String
  propertyType String        @map("property_type")
  bedrooms     Int?
  bathrooms    Int?
  area         Decimal       @db.Decimal(10, 2)
  status       ListingStatus @default(PENDING)
  images       Json          @default("[]")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  lister User @relation(fields: [listerId], references: [id], onDelete: Cascade)

  @@map("listings")
  @@index([status, listerId])
  @@index([type])
  @@index([location])
  @@index([price])
  @@index([propertyType])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// PaymentRequest
// Generated by advisors, bank details, invoice-based, logged
// -----------------------------------------------------------------------------
model PaymentRequest {
  id          String        @id @default(cuid())
  advisorId   String        @map("advisor_id")
  leadId      String        @map("lead_id")
  amount      Decimal       @db.Decimal(15, 2)
  currency    String        @default("AED")
  bankDetails Json          @map("bank_details")
  status      PaymentStatus @default(PENDING)
  invoiceId   String        @unique @map("invoice_id")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  advisor User @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("payment_requests")
  @@index([advisorId, status])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Disclaimer
// Displayed on pages/PDFs/calculators/footer
// -----------------------------------------------------------------------------
model Disclaimer {
  id        String          @id @default(cuid())
  key       String          @unique
  title     String
  content   String          @db.Text
  page      DisclaimerPage
  active    Boolean         @default(true)
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("disclaimers")
  @@index([page])
  @@index([active])
}

// -----------------------------------------------------------------------------
// AuditLog
// Track all user actions and system events
// -----------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// EmailLog
// Track email notifications to leads
// -----------------------------------------------------------------------------
model EmailLog {
  id             String       @id @default(cuid())
  leadId         String       @map("lead_id")
  template       String
  recipientEmail String       @map("recipient_email")
  sentAt         DateTime?    @map("sent_at")
  status         EmailStatus  @default(PENDING)
  retryCount     Int          @default(0) @map("retry_count")
  errorMessage   String?      @map("error_message")
  createdAt      DateTime     @default(now()) @map("created_at")

  // Relations
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("email_logs")
  @@index([leadId])
  @@index([status])
  @@index([recipientEmail])
  @@index([createdAt])
}
